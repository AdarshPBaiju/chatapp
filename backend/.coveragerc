[run]
source =
    users
    authentication
    core
    apps
    .
omit =
    *tests*
    *migrations*
    manage.py
    config/*
    */tests/*
    */migrations/*
    backend/manage.py
    backend/config/*

[report]
show_missing = True
exclude_lines =
    pragma: no cover
    def __str__
    def __repr__
    if TYPE_CHECKING:
    if __name__ == .__main__.:
